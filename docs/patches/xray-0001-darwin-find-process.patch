index 0000000..3d40e05
--- /dev/null
+++ b/common/net/find_process_darwin.go
@@ -0,0 +1,180 @@
+//go:build darwin
+
+package net
+
+import (
+	"bytes"
+	"encoding/binary"
+	"net"
+	"net/netip"
+	"path/filepath"
+	"time"
+
+	"golang.org/x/sys/unix"
+
+	"github.com/xtls/xray-core/common/errors"
+)
+
+// macOS process lookup for routing "process" rules (Devnet dVPN patch, #33): the kernel's
+// socket list (sysctl net.inet.{tcp,udp}.pcblist_n) gives the pid that last used a local
+// address:port, and kern.procargs2 gives that process's executable path. The list is walked by
+// each record's own length and kind, so it does not depend on struct sizes that change between
+// macOS releases. Offsets inside xinpcb_n / xsocket_n (bsd/netinet/in_pcb.h, #pragma pack(4)).
+const (
+	xsoSocket = 0x001
+	xsoInpcb  = 0x010
+
+	inpLportOff  = 18 // xinpcb_n.inp_lport (network order)
+	inpVflagOff  = 44 // xinpcb_n.inp_vflag
+	inpLaddr6Off = 64 // xinpcb_n.inp_dependladdr (in6_addr; IPv4 in the last 4 bytes)
+	inpMinLen    = 80
+	soLastPidOff = 68 // xsocket_n.so_last_pid
+	soMinLen     = 72
+
+	inpIPv4 = 0x1
+	inpIPv6 = 0x2
+)
+
+func FindProcess(dest Destination) (PID int, Name string, AbsolutePath string, err error) {
+	isLocal, err := isLocalFresh(dest.Address.IP())
+	if err != nil {
+		return 0, "", "", errors.New("failed to determine if address is local: ", err)
+	}
+	if !isLocal {
+		return 0, "", "", ErrNotLocal
+	}
+
+	var mib string
+	switch dest.Network {
+	case Network_TCP:
+		mib = "net.inet.tcp.pcblist_n"
+	case Network_UDP:
+		mib = "net.inet.udp.pcblist_n"
+	default:
+		return 0, "", "", errors.New("process lookup supports TCP and UDP only")
+	}
+
+	ip, ok := netip.AddrFromSlice(dest.Address.IP())
+	if !ok {
+		return 0, "", "", errors.New("process lookup needs an IP source address")
+	}
+
+	buf, err := unix.SysctlRaw(mib)
+	if err != nil {
+		return 0, "", "", errors.New("reading ", mib).Base(err)
+	}
+
+	pid, found := findPID(buf, ip.Unmap(), uint16(dest.Port), dest.Network == Network_UDP)
+	if !found {
+		return 0, "", "", errors.New("no local process owns ", dest.NetAddr())
+	}
+
+	path, err := executablePath(pid)
+	if err != nil {
+		return 0, "", "", err
+	}
+
+	return pid, filepath.Base(path), path, nil
+}
+
+// findPID walks a pcblist_n buffer. An exact address match wins; for UDP a socket bound to the
+// unspecified address of the same family is the fallback (most UDP sockets are not connected).
+func findPID(buf []byte, ip netip.Addr, port uint16, udp bool) (int, bool) {
+	if len(buf) < 4 {
+		return 0, false
+	}
+
+	off := roundUp8(int(binary.NativeEndian.Uint32(buf[0:4]))) // the leading xinpgen
+	fallback := -1
+
+	var (
+		have    bool
+		inpPort uint16
+		inpAddr netip.Addr
+	)
+
+	for off+8 <= len(buf) {
+		l := int(binary.NativeEndian.Uint32(buf[off : off+4]))
+		kind := binary.NativeEndian.Uint32(buf[off+4 : off+8])
+		if l < 8 || off+l > len(buf) || l == 24 { // 24 = the trailing xinpgen
+			break
+		}
+
+		rec := buf[off : off+l]
+
+		switch {
+		case kind == xsoInpcb && l >= inpMinLen:
+			have = true
+			inpPort = binary.BigEndian.Uint16(rec[inpLportOff : inpLportOff+2])
+			vflag := rec[inpVflagOff]
+			switch {
+			case vflag&inpIPv4 != 0 && ip.Is4():
+				inpAddr = netip.AddrFrom4([4]byte(rec[inpLaddr6Off+12 : inpLaddr6Off+16]))
+			case vflag&inpIPv6 != 0 && ip.Is6():
+				inpAddr = netip.AddrFrom16([16]byte(rec[inpLaddr6Off : inpLaddr6Off+16]))
+			default:
+				have = false
+			}
+		case kind == xsoSocket && l >= soMinLen && have:
+			have = false
+			if inpPort != port {
+				break
+			}
+
+			pid := int(int32(binary.NativeEndian.Uint32(rec[soLastPidOff : soLastPidOff+4])))
+			if inpAddr == ip {
+				return pid, true
+			}
+
+			if udp && inpAddr.IsUnspecified() && fallback < 0 {
+				fallback = pid
+			}
+		}
+
+		off += roundUp8(l)
+	}
+
+	return fallback, fallback >= 0
+}
+
+func roundUp8(n int) int { return (n + 7) &^ 7 }
+
+// executablePath: kern.procargs2 = int32 argc, then the executable path (NUL-terminated).
+func executablePath(pid int) (string, error) {
+	raw, err := unix.SysctlRaw("kern.procargs2", pid)
+	if err != nil {
+		return "", errors.New("reading the executable of pid ", pid).Base(err)
+	}
+
+	if len(raw) < 5 {
+		return "", errors.New("no executable path for pid ", pid)
+	}
+
+	p := raw[4:]
+	if i := bytes.IndexByte(p, 0); i >= 0 {
+		p = p[:i]
+	}
+
+	if len(p) == 0 {
+		return "", errors.New("no executable path for pid ", pid)
+	}
+
+	return string(p), nil
+}
+
+// isLocalFresh is IsLocal, but a "not local" answer from an address list older than a second is
+// checked again against a fresh list. IsLocal caches the list for a minute; when the first lookup
+// ran before the TUN had its address (169.254.10.2), every app connection from the TUN read as
+// "not local" for that minute and took the default route: an excluded app went to the VPN
+// (Devnet dVPN Mac rig 3, V2Ray/Xray split by app, first minute).
+func isLocalFresh(ip net.IP) (bool, error) {
+	isLocal, err := IsLocal(ip)
+	if err != nil || isLocal {
+		return isLocal, err
+	}
+	if entry := localIPCache.Load(); entry != nil && time.Since(entry.lastUpdate) > time.Second {
+		localIPCache.Store(nil)
+		return IsLocal(ip)
+	}
+	return false, nil
+}
diff --git a/common/net/find_process_darwin_test.go b/common/net/find_process_darwin_test.go
new file mode 100644
index 0000000..55212cc
--- /dev/null
+++ b/common/net/find_process_darwin_test.go
@@ -0,0 +1,131 @@
+//go:build darwin
+
+package net
+
+import (
+	"context"
+	gonet "net"
+	"net/netip"
+	"os"
+	"testing"
+	"time"
+)
+
+// Real sockets of this test process, looked up through the kernel lists.
+func TestFindProcessDarwinTCPAndUDP(t *testing.T) {
+	self, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	ln, err := gonet.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+
+	go func() {
+		c, err := ln.Accept()
+		if err == nil {
+			defer c.Close()
+			buf := make([]byte, 1)
+			_, _ = c.Read(buf)
+		}
+	}()
+
+	conn, err := (&gonet.Dialer{}).DialContext(context.Background(), "tcp4", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+
+	local := conn.LocalAddr().(*gonet.TCPAddr)
+	pid, name, path, err := FindProcess(TCPDestination(IPAddress(local.IP), Port(local.Port)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if pid != os.Getpid() || path != self || name == "" {
+		t.Fatalf("tcp: got pid %d name %q path %q, want pid %d path %q", pid, name, path, os.Getpid(), self)
+	}
+
+	udp, err := gonet.ListenPacket("udp4", "0.0.0.0:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer udp.Close()
+
+	port := udp.LocalAddr().(*gonet.UDPAddr).Port
+	pid, _, path, err = FindProcess(UDPDestination(IPAddress(gonet.IPv4(127, 0, 0, 1)), Port(port)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if pid != os.Getpid() || path != self {
+		t.Fatalf("udp unspecified: got pid %d path %q", pid, path)
+	}
+
+	// IPv6 loopback.
+	ln6, err := gonet.Listen("tcp6", "[::1]:0")
+	if err != nil {
+		t.Skip("no IPv6 loopback:", err)
+	}
+	defer ln6.Close()
+
+	go func() {
+		c, err := ln6.Accept()
+		if err == nil {
+			defer c.Close()
+			buf := make([]byte, 1)
+			_, _ = c.Read(buf)
+		}
+	}()
+
+	c6, err := gonet.Dial("tcp6", ln6.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c6.Close()
+
+	l6 := c6.LocalAddr().(*gonet.TCPAddr)
+	pid, _, _, err = FindProcess(TCPDestination(IPAddress(l6.IP), Port(l6.Port)))
+	if err != nil || pid != os.Getpid() {
+		t.Fatalf("tcp6: got pid %d err %v", pid, err)
+	}
+}
+
+func TestFindProcessDarwinMisses(t *testing.T) {
+	if _, _, _, err := FindProcess(TCPDestination(IPAddress(gonet.IPv4(8, 8, 8, 8)), Port(53))); err != ErrNotLocal {
+		t.Fatalf("remote address: %v", err)
+	}
+
+	// A local port nobody uses.
+	if _, _, _, err := FindProcess(TCPDestination(IPAddress(gonet.IPv4(127, 0, 0, 1)), Port(1))); err == nil {
+		t.Fatal("found an owner for an unused port")
+	}
+
+	if pid, ok := findPID(nil, netip.MustParseAddr("127.0.0.1"), 1, false); ok || pid != 0 {
+		t.Fatal("empty buffer")
+	}
+
+	// Truncated / corrupt buffers never panic.
+	for _, b := range [][]byte{{24, 0, 0, 0}, {24, 0, 0, 0, 0, 0, 0, 0, 255, 255, 255, 255, 16, 0, 0, 0}, make([]byte, 7)} {
+		findPID(b, netip.MustParseAddr("127.0.0.1"), 1, true)
+	}
+}
+
+// A "not local" from a stale address list is checked again: the list was read before the TUN had
+// its address, and every app connection from the TUN took the default route for a minute.
+func TestIsLocalFreshRereadsAStaleList(t *testing.T) {
+	defer localIPCache.Store(nil)
+
+	loopback := gonet.IPv4(127, 0, 0, 1)
+
+	localIPCache.Store(&localIPCacheEntry{lastUpdate: time.Now().Add(-2 * time.Second)})
+	if ok, err := isLocalFresh(loopback); err != nil || !ok {
+		t.Fatalf("stale list without loopback: isLocalFresh = %v, %v; want true (re-read)", ok, err)
+	}
+
+	localIPCache.Store(&localIPCacheEntry{lastUpdate: time.Now()})
+	if ok, err := isLocalFresh(loopback); err != nil || ok {
+		t.Fatalf("list read this second: isLocalFresh = %v, %v; want false (no re-read storm)", ok, err)
+	}
+}
